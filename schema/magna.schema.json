{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/magna/plugin-sdk/main/schema/magna.schema.json",
    "title": "Magna plugin manifest (magna.json)",
    "type": "object",
    "required": ["name", "displayName", "description", "version", "author", "license", "compat", "entry", "permissions"],
    "additionalProperties": true,
    "properties": {
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9_-]*[a-z0-9])?\\/[a-z0-9]([a-z0-9_-]*[a-z0-9])?$",
            "description": "vendor/package identifier, lowercase."
        },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+",
            "description": "Semantic version, e.g. 1.2.0."
        },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "compat": {
            "type": "object",
            "required": ["magna"],
            "properties": {
                "magna": { "type": "string", "description": "semver constraint against the Magna core version, e.g. ^1.0." },
                "php": { "type": "string" }
            }
        },
        "entry": {
            "type": "string",
            "description": "Fully-qualified entry class extending Magna\\Plugins\\Plugin."
        },
        "provides": {
            "type": "object",
            "description": "Optional capability hints surfaced in the admin UI.",
            "additionalProperties": { "type": "boolean" }
        },
        "permissions": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
                "description": "Dot-separated permission key, e.g. plugin.resource.action."
            }
        },
        "uninstall": {
            "type": "object",
            "description": "What to clean up on uninstall --purge.",
            "properties": {
                "tables": { "type": "array", "items": { "type": "string" } },
                "contentTypes": { "type": "array", "items": { "type": "string" } }
            }
        }
    }
}
