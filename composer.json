{
    "name": "magna-cms/plugin-sdk",
    "description": "The official SDK for building Magna CMS plugins — extension contracts, the plugin base class, and the manifest spec.",
    "type": "library",
    "keywords": ["magna", "magna-cms", "cms", "plugin", "sdk", "laravel"],
    "license": "MIT",
    "homepage": "https://github.com/Magna-CMS/Magna-Plugin-SDK",
    "support": {
        "issues": "https://github.com/Magna-CMS/Magna-Plugin-SDK/issues",
        "source": "https://github.com/Magna-CMS/Magna-Plugin-SDK",
        "docs": "https://github.com/Magna-CMS/Magna-Plugin-SDK/tree/main/docs"
    },
    "authors": [
        { "name": "Magna Team" }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "illuminate/contracts": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Magna\\Contracts\\": "src/Contracts/",
            "Magna\\Captcha\\": "src/Captcha/",
            "Magna\\Plugins\\": "src/Plugins/",
            "Magna\\Admin\\Nav\\": "src/Nav/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Magna\\PluginSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
